@echo off
setlocal enabledelayedexpansion
REM ============================================================
REM  One-time MySQL bootstrap for the XHW project.
REM
REM  What it does:
REM    1. CREATE DATABASE xhw (utf8mb4) + a dedicated user xhw
REM    2. Import src\main\resources\db\xhw.sql  (the CURRENT seed)
REM    3. Print row counts so you can see it actually worked
REM    4. (optional) dump + drop the LEGACY hmdp database left over
REM       from before the project was renamed
REM
REM  Do NOT import the upstream-original.sql in the project root:
REM  that is the ORIGINAL upstream script (11 tables, 14 shops,
REM  no province / district columns). The current seed lives under
REM  src\main\resources\db\ and is generated by
REM  _qa\_gen_nationwide_sql.py - regenerate it, never hand-edit.
REM
REM  The root password is asked ONCE and written to a temp defaults
REM  file, so it never appears on a command line (where any process
REM  could read it back out of the process list). That temp file is
REM  deleted at the end, including on every early-exit path.
REM
REM  Everything below is ASCII on purpose: a .bat with non-ASCII text
REM  turns into mojibake depending on the machine's code page.
REM  Safe to re-run.
REM ============================================================

set "MYSQLDIR=C:\Program Files\MySQL\MySQL Server 8.0\bin"
set "MYSQL=%MYSQLDIR%\mysql.exe"
set "MYSQLDUMP=%MYSQLDIR%\mysqldump.exe"
set "DBNAME=xhw"
set "DBUSER=xhw"
set "DBPASS=xhw123456"
set "OLDDB=hmdp"
set "SCRIPT=%~dp0src\main\resources\db\xhw.sql"
set "CNF=%TEMP%\xhw-root-%RANDOM%.cnf"
set "OLDDUMP=%~dp0_backup_legacy_hmdp.sql"

if not exist "%MYSQL%" (
  echo [x] mysql.exe not found at:
  echo     %MYSQL%
  echo     Edit the MYSQLDIR line at the top of this file and re-run.
  pause
  exit /b 1
)
if not exist "%SCRIPT%" (
  echo [x] seed script not found:
  echo     %SCRIPT%
  pause
  exit /b 1
)

echo.
echo ============================================================
echo   XHW  MySQL bootstrap
echo ============================================================
echo   target db   : %DBNAME%   (user %DBUSER%)
echo   seed script : %SCRIPT%
echo.
echo   The MySQL root password is needed once.
set /p "ROOTPW=root password: "
if "%ROOTPW%"=="" (
  echo [x] empty password, aborted.
  pause
  exit /b 1
)
REM write a temp defaults file: safer than -pPASSWORD, which every
REM other process on the machine can read out of the process list
> "%CNF%" echo [client]
>> "%CNF%" echo user=root
>> "%CNF%" echo password=%ROOTPW%

echo.
echo === 1/4  create database and user ===
"%MYSQL%" --defaults-extra-file="%CNF%" --default-character-set=utf8mb4 -e "CREATE DATABASE IF NOT EXISTS %DBNAME% DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci; CREATE USER IF NOT EXISTS '%DBUSER%'@'127.0.0.1' IDENTIFIED BY '%DBPASS%'; GRANT ALL PRIVILEGES ON %DBNAME%.* TO '%DBUSER%'@'127.0.0.1'; FLUSH PRIVILEGES;"
if errorlevel 1 (
  echo.
  echo [x] step 1 failed. Wrong root password?
  del "%CNF%" >nul 2>&1
  pause
  exit /b 1
)

echo.
echo === 2/4  import seed data ===
echo     this DROPs and recreates every table in %DBNAME%, so re-running is safe
"%MYSQL%" -h 127.0.0.1 -u %DBUSER% -p%DBPASS% --default-character-set=utf8mb4 %DBNAME% < "%SCRIPT%"
if errorlevel 1 (
  echo.
  echo [x] step 2 failed. The import error is above.
  del "%CNF%" >nul 2>&1
  pause
  exit /b 1
)

echo.
echo === 3/4  verify ===
"%MYSQL%" -h 127.0.0.1 -u %DBUSER% -p%DBPASS% --default-character-set=utf8mb4 %DBNAME% -e "SELECT COUNT(*) AS shops FROM tb_shop; SELECT COUNT(*) AS blogs FROM tb_blog; SELECT COUNT(*) AS addresses FROM tb_address;"
if errorlevel 1 (
  echo.
  echo [x] step 3 failed. Connection check failed.
  del "%CNF%" >nul 2>&1
  pause
  exit /b 1
)

echo.
echo === 4/4  legacy database "%OLDDB%" ===
set "HASOLD="
REM -N already suppresses the column header, so do NOT add skip=1 here:
REM it would eat the single result row and the script would always claim
REM the legacy database is absent.
for /f %%r in ('"%MYSQL%" --defaults-extra-file="%CNF%" -N -B -e "SHOW DATABASES LIKE '%OLDDB%';" 2^>nul') do set "HASOLD=1"

if not defined HASOLD (
  echo     not present, nothing to clean up.
  goto :done
)

echo     found a leftover "%OLDDB%" database (from before the rename).
echo     It holds the SAME seed data plus anything you added by hand
echo     while the project still used it.
echo.
echo     It will be dumped to:
echo       %OLDDUMP%
echo     and then DROPPED together with the user '%OLDDB%'@'127.0.0.1'.
echo.
set /p "ANS=type YES to dump and drop it (anything else skips): "
if /i not "%ANS%"=="YES" (
  echo     skipped. "%OLDDB%" left untouched.
  goto :done
)

echo     dumping ...
"%MYSQLDUMP%" --defaults-extra-file="%CNF%" --default-character-set=utf8mb4 --databases %OLDDB% > "%OLDDUMP%"
if errorlevel 1 (
  echo     [x] dump failed - NOT dropping anything, the data is still there.
  goto :done
)
for %%f in ("%OLDDUMP%") do echo     dump written: %%~zf bytes

"%MYSQL%" --defaults-extra-file="%CNF%" -e "DROP DATABASE IF EXISTS %OLDDB%; DROP USER IF EXISTS '%OLDDB%'@'127.0.0.1'; FLUSH PRIVILEGES;"
if errorlevel 1 (
  echo     [x] drop failed, see the error above.
) else (
  echo     [ok] %OLDDB% database and user removed.
)

:done
del "%CNF%" >nul 2>&1

echo.
echo ============================================================
echo   [ok] database "%DBNAME%" is ready.
echo        user     : %DBUSER%
echo        password : %DBPASS%
echo        jdbc url : "jdbc:mysql://127.0.0.1:3306/%DBNAME%?useSSL=false&serverTimezone=UTC&characterEncoding=utf8&allowPublicKeyRetrieval=true"
echo.
echo   Note allowPublicKeyRetrieval=true above: MySQL 8 defaults to
echo   caching_sha2_password and JDBC refuses the key exchange without it.
echo.
echo   Redis needs NO changes. None of its key names ever contained the
echo   old brand, and the shop caches are rewritten on every start.
echo ============================================================
pause
